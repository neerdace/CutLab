# Copy this file to .env and change the values before deploying anywhere public.

PORT=3000

# Used to sign login sessions (JWT). Must be a long, random, secret string.
JWT_SECRET=change-this-to-a-long-random-string

# The first admin account is created automatically the first time the server
# starts, using these credentials. Change them (or just log in and create a
# new admin from the panel, then demote/delete this one) after first login.
ADMIN_EMAIL=admin@cutlab.test
ADMIN_PASSWORD=Admin123!
